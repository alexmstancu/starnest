# Copy to .env and fill in. .env is gitignored and must never be committed.
#
#   cp .env.example .env
#
# This file holds TECHNICAL configuration only -- how to reach things. Domain configuration
# (attributes, weights, thresholds, source priority) is data in the database, shipped as
# migrations, and never appears here (arch.md 1.2, 7.5). If you find yourself wanting to add
# a weight or a threshold to this file, that is the invariant telling you something.
#
# Real values are placeholders below. Nothing here is a working credential.

# --- Database -----------------------------------------------------------------
POSTGRES_DB=starnest
POSTGRES_USER=starnest
POSTGRES_PASSWORD=change-me-before-first-run

# Used when running the backend OUTSIDE Docker, against the published port.
# Inside compose this is overridden to point at the `database` service.
DATABASE_URL=postgresql://starnest:change-me-before-first-run@127.0.0.1:5432/starnest

# --- Ports, published to 127.0.0.1 only ---------------------------------------
# There is no authentication in this application, ever (reqs.md 10). Binding to localhost
# is the entire security model, which is why it is stated rather than assumed.
DATABASE_PORT=5432
BACKEND_PORT=8000
UI_PORT=5173

# --- Secrets ------------------------------------------------------------------
# A dedicated key from console.anthropic.com, billed per usage and separate from a Claude.ai
# subscription. Needed only for the LLM acquisition path (reqs.md 6.10) -- the MVP is
# country-level and uses it for one attribute, so leaving this empty is valid.
#
# NEVER commit a real key. It is read once at startup, held by the LLM adapter, and written
# to no log, no database row and no error message (arch.md 7.5).
ANTHROPIC_API_KEY=

# --- Application --------------------------------------------------------------
LOG_LEVEL=INFO

# The one place the product name is a value rather than an identifier. Renaming the product
# is a change to this line and nothing else (CLAUDE.md).
APP_DISPLAY_NAME=Starnest
