# Copy to .env and fill in. .env is gitignored and must never be committed.
#
#   cp .env.example .env
#
# This file holds TECHNICAL configuration only -- how to reach things. Domain configuration
# (attributes, weights, thresholds, source priority) is data in the database, shipped as
# migrations, and never appears here (arch.md 1.2, 7.5). If you find yourself wanting to add
# a weight or a threshold to this file, that is the invariant telling you something.
#
# Real values are placeholders below. Nothing here is a working credential.

# --- Database -----------------------------------------------------------------
POSTGRES_DB=starnest
POSTGRES_USER=starnest
POSTGRES_PASSWORD=change-me-before-first-run

# Used when running the backend OUTSIDE Docker, against the published port.
# Inside compose this is overridden to point at the `database` service.
DATABASE_URL=postgresql://starnest:change-me-before-first-run@127.0.0.1:5432/starnest

# --- Ports, published to 127.0.0.1 only ---------------------------------------
# There is no authentication in this application, ever (reqs.md 10). Binding to localhost
# is the entire security model, which is why it is stated rather than assumed.
DATABASE_PORT=5432
BACKEND_PORT=8000
UI_PORT=5173
# The live ER diagram (docker compose service schema-diagram). Not 4173: `make schema-diagram-open`
# serves there from the command line, and the two should be able to run side by side.
SCHEMA_DIAGRAM_PORT=4174

# --- Secrets ------------------------------------------------------------------
# A dedicated key from console.anthropic.com, billed per usage and separate from a Claude.ai
# subscription. Needed only for the LLM acquisition path (reqs.md 6.10) -- the MVP is
# country-level and uses it for one attribute, so leaving this empty is valid.
#
# NEVER commit a real key. It is read once at startup, held by the LLM adapter, and written
# to no log, no database row and no error message (arch.md 7.5).
ANTHROPIC_API_KEY=

# --- what the LLM path costs (reqs.md 6.3, 6.10) ------------------------------------------
# Required for the LLM path, and deliberately without defaults: a run that cannot measure its
# own cost cannot be capped, and a default of zero would make the cap ornamental. Absent means
# the LLM path stays off, which the boot log says out loud.
#
# **Copied from the pricing page exactly as it states them, in USD.** Anthropic publishes and
# bills in dollars; this application works in euro, so EUR_USD_RATE converts -- which is the
# rule reqs.md 5.5 applies to every monetary value: a conversion names its rate. Pasting the
# page's own numbers means no mental arithmetic between reading a price and setting it, and no
# silent drift when one changes.
#
#   Model prices: platform.claude.com/docs/en/about-claude/pricing -> "Model pricing"
#                 (the row for LLM_MODEL; input and output are different numbers)
#   Web search:   same page -> "Web search tool", published per 1,000 searches -> divide by 1000
#   The rate:     ecb.europa.eu/stats/eurofxref/eurofxref-daily.xml, quoted as 1 EUR = n USD
#
# The values below are Claude Sonnet 5 and the ECB rate of 2026-09-11. Re-check both when they
# matter: the cap is a guard, so being within a percent is the whole requirement.
LLM_MODEL=claude-sonnet-5
LLM_INPUT_USD_PER_MTOK=2
LLM_OUTPUT_USD_PER_MTOK=10
LLM_USD_PER_WEB_SEARCH=0.01
EUR_USD_RATE=1.1592

# How many input tokens one call bills. **Measured, not guessed**: a searching model has the
# pages it read injected into its context, so the prompt's own length says almost nothing about
# what is billed -- and the input side dominates the bill.
#
# `make live-llm` makes one real call and prints the figure; paste what it says. The value
# below is a real measurement from 2026-09-13: 12,674 input tokens for one gate-shaped question. Required for
# the same reason as the prices: without it a run cannot be estimated before it spends
# (reqs.md 6.3), so the LLM path stays off and the boot log says which variable is missing.
#
# It feeds the estimate only. What is *charged* is always what the provider reported, so a
# figure set too low costs money rather than accuracy -- and the spend cap is what catches it.
LLM_INPUT_TOKENS_PER_CALL=12674

# --- Application --------------------------------------------------------------
LOG_LEVEL=INFO

# The one place the product name is a value rather than an identifier. Renaming the product
# is a change to this line and nothing else (CLAUDE.md).
APP_DISPLAY_NAME=Starnest
