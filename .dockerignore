# The build context is the repository root, so the UI and the documents are excluded too.
ui/
docs/
.git/
.claude/
backups/

# The build context is backend/. Keep it to what the image actually needs.
backend/.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
backend/tests/
*.egg-info/

# Never let a secret into a build context. Even unused, it lands in the layer cache.
.env
.env.*
